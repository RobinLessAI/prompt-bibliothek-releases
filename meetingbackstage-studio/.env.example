# Kopieren nach .env.local und ausfüllen. .env.local wird nicht eingecheckt.
# Werte aus deiner Zoom-App im Marketplace (General App, vom Nutzer verwaltet):
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Unter „Access“ → „Secret Token“ der Zoom-App (für die Prüfung der Webhooks):
ZOOM_WEBHOOK_SECRET_TOKEN=
# Optional: anderer Port als 4300
# PORT=4300
