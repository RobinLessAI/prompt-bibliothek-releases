{
  "name": "meetingbackstage-studio",
  "private": true,
  "version": "0.1.0",
  "description": "MeetingBackstage Studio: klickbarer Desktop-Prototyp eines Produktionspults für Online-Meetings und Workshops (Demo, ohne echte Integrationen).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --no-warnings=ExperimentalWarning \"tests/*.test.ts\"",
    "map:generate": "node scripts/generate-world-map.mjs",
    "start": "npm run build && node server/server.mjs",
    "server": "node server/server.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
